# Variables de compilación. Un sitio estático no tiene servidor: se escriben dentro del JavaScript al
# ejecutar `npm run build`. Todas son opcionales. En GitHub se definen como Variables de Actions
# (Settings > Secrets and variables > Actions > Variables). Para probar en local, copia este archivo a
# .env.local (no se sube a GitHub).

# URL pública del sitio (metadatos y OG), p. ej. https://equiposcomerciales.fivo.info
NEXT_PUBLIC_SITE_URL=

# Vídeo del VSL: URLs externas (nada de vídeo en el repositorio)
NEXT_PUBLIC_VIDEO_URL=
NEXT_PUBLIC_VIDEO_POSTER_URL=
NEXT_PUBLIC_VIDEO_CAPTIONS_URL=
# Segundo del VSL en que empieza la llamada a la acción (por defecto 10; "none" lo desactiva)
NEXT_PUBLIC_VIDEO_CTA_SECOND=


# Analítica (solo se carga tras aceptar cookies)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=


# Calculadora de /gracias: destino (POST JSON) de "Enviarme mi informe". Vacío, como en la original, el formulario queda oculto
NEXT_PUBLIC_CALCULATOR_LEAD_ENDPOINT=
